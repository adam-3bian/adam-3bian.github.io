layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% assign sitemap_items = site.pages | concat: site.documents %}
{% for entry in sitemap_items %}
  {% if entry.title and entry.path contains '.md' and entry.alternate != true and entry.unlisted != true and entry.url != '/404.html' %}
  <url><loc>{{ entry.url | absolute_url | escape }}</loc></url>
  {% endif %}
{% endfor %}
</urlset>
