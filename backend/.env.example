# Copy to .env on the separate backend host, outside its public/ web root.
FORM_ENABLED=false
FORM_ALLOWED_ORIGINS=https://adam-3bian.github.io
FORM_CONTACT_RECIPIENT=
FORM_APPLICATION_RECIPIENT=

SMTP_HOST=
SMTP_PORT=587
# tls = STARTTLS on port 587; ssl = implicit TLS on port 465.
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME="Small Heath Park Housing Co-operative"

# Generate with: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
ALTCHA_SECRET=
ALTCHA_COST=1000
ALTCHA_MAX_COUNTER=2000
ALTCHA_EXPIRES=600
FORM_RATE_LIMIT=5
FORM_CHALLENGE_LIMIT=60
