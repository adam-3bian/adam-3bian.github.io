{
  "name": "snow-hill-lines",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check": "node scripts/check-js.mjs",
    "build": "npm run check && vite build",
    "test": "node --test --test-concurrency=3 tests/*.test.js",
    "validate": "node scripts/validate-world.js",
    "preview": "vite preview --host 0.0.0.0",
    "build:site": "npm run check && vite build --outDir site && node scripts/site-manifest.mjs --write",
    "verify:site": "node scripts/site-manifest.mjs --check",
    "audit:geometry": "node --expose-gc scripts/audit-geometry.js",
    "diagnose:world": "node scripts/diagnose-grid-world.js",
    "build:qa": "npm run check && vite build --mode qa --outDir work/qa-dist",
    "build:world": "node scripts/build-grid-world.js"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.7",
    "fast-xml-parser": "^5.11.2",
    "playwright-core": "^1.64.1",
    "proj4": "^2.22.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
