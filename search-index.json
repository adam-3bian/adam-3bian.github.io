---
layout: null
permalink: /search-index.json
---
[
{% assign searchable_pages = site.pages | concat: site.documents %}
{% assign separator = '' %}
{% for entry in searchable_pages %}
  {% if entry.title and entry.path contains '.md' and entry.alternate != true and entry.url != '/search/' and entry.url != '/404.html' %}
    {% assign readable_text = entry.content | markdownify | strip_html | normalize_whitespace %}
    {% assign kind = entry.collection | default: 'pages' %}
    {{ separator }}
    {
      "title": {{ entry.title | jsonify }},
      "url": {{ entry.url | relative_url | jsonify }},
      "type": {{ kind | jsonify }},
      "summary": {{ readable_text | truncate: 220 | jsonify }},
      "text": {{ readable_text | jsonify }},
      "roles": []
    }
    {% assign separator = ',' %}
  {% endif %}
{% endfor %}
]
