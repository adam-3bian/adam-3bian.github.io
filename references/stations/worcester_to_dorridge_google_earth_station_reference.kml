<?xml version="1.0" encoding="utf-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Worcester Shrub Hill to Dorridge — Google Earth station reference</name>
    <description>Station-location reference for railway route building. This file has accurately georeferenced station pins from published OS National Grid references, NOT an accurate track centreline. Open in Google Earth and turn on satellite imagery. Check acquisition dates; rail infrastructure can change. Sources: railwaydata.co.uk/stations/overview/ and abcrailwayguide.uk for Olton. Maps and imagery are owned by their respective providers. Reuse governed by their licences.</description>
    <Style id="railStation">
      <IconStyle>
        <color>ff167cff</color>
        <scale>1.0</scale>
        <Icon>
          <href>https://maps.google.com/mapfiles/kml/paddle/red-circle.png</href>
        </Icon>
      </IconStyle>
    </Style>
    <Style id="branchStation">
      <IconStyle>
        <color>ffcc7700</color>
        <scale>0.9</scale>
        <Icon>
          <href>https://maps.google.com/mapfiles/kml/paddle/blu-circle.png</href>
        </Icon>
      </IconStyle>
    </Style>
