{
  "commit": "616b0c1",
  "glossary": [
    {
      "title": "ABI",
      "link": null,
      "definition": "Application Binary Interface. The conventions that let compiled code, libraries, and an operating system agree on data layouts, calling conventions, registers, and binary formats.",
      "anchor": "glossary-term-abi"
    },
    {
      "title": "Ambient authority",
      "link": null,
      "definition": "Authority available to code without being passed explicitly. Capability systems seek to reduce ambient authority so that access is tied to specific capabilities.",
      "anchor": "glossary-term-ambient-authority"
    },
    {
      "title": "Attack surface",
      "link": null,
      "definition": "All the parts of a system that an attacker could potentially target or exploit to gain access or cause harm.",
      "anchor": "glossary-term-attack-surface"
    },
    {
      "title": "Authority",
      "link": null,
      "definition": "The right to access a resource or perform an operation. A CHERI capability carries authority through its bounds, permissions, validity, and sealing state.",
      "anchor": "glossary-term-authority"
    },
    {
      "title": "Bounds",
      "link": "/build/technology/cheri-capabilities/capabilities/",
      "definition": "The lower and upper limits of the memory region that a capability can address. A memory access outside those limits is rejected by the processor.",
      "anchor": "glossary-term-bounds"
    },
    {
      "title": "Bounds compression",
      "link": null,
      "definition": "An encoding technique that represents a capability's bounds compactly alongside its address and other metadata. Some bounds cannot be represented exactly and are rounded to a representable range.",
      "anchor": "glossary-term-bounds-compression"
    },
    {
      "title": "CHERI",
      "link": "/discover/why-cheri/why-cheri/",
      "definition": "Capability Hardware Enhanced RISC Instructions. An architectural protection model that adds hardware-supported capabilities to conventional processor architectures.",
      "anchor": "glossary-term-cheri"
    },
    {
      "title": "CHERI C/C++",
      "link": null,
      "definition": "C and C++ language and ABI adaptations that represent pointers with CHERI capabilities and expose capability-aware operations where needed.",
      "anchor": "glossary-term-cheri-c-c"
    },
    {
      "title": "CHERIoT",
      "link": "/hardware/cheriot/",
      "definition": "A CHERI-based hardware-software platform designed for small embedded systems, with memory safety and fine-grained compartments built into its processor and RTOS model.",
      "anchor": "glossary-term-cheriot"
    },
    {
      "title": "Capability",
      "link": "/build/technology/how-cheri-capabilities-work/",
      "definition": "A hardware-protected reference that that carries a memory location, the bounds of the memory region, the access rights associated with it, and some other metadata.",
      "anchor": "glossary-term-capability"
    },
    {
      "title": "Capability fault",
      "link": null,
      "definition": "An exception raised when an operation violates a capability rule, such as using an invalid capability, accessing outside its bounds, or attempting an operation without the required permission.",
      "anchor": "glossary-term-capability-fault"
    },
    {
      "title": "Capability provenance",
      "link": "/build/technology/cheri-capabilities/provenance/",
      "definition": "The valid derivation history that connects a capability to existing authority. Integer values cannot simply be converted into usable capabilities with new authority.",
      "anchor": "glossary-term-capability-provenance"
    },
    {
      "title": "Capability register",
      "link": null,
      "definition": "A processor register able to hold a complete capability, including its address and protected metadata.",
      "anchor": "glossary-term-capability-register"
    },
    {
      "title": "CheriABI",
      "link": "/build/technology/pure-capability-systems/",
      "definition": "A pure-capability POSIX process environment developed for CheriBSD in which C and C++ pointers are represented as capabilities.",
      "anchor": "glossary-term-cheriabi"
    },
    {
      "title": "CheriBSD",
      "link": "/software/cheribsd/",
      "definition": "A FreeBSD-derived research operating system used to develop and evaluate CHERI memory protection and compartmentalisation.",
      "anchor": "glossary-term-cheribsd"
    },
    {
      "title": "Compartment",
      "link": "/guides/build-compartments/",
      "definition": "A software component isolated from other components and given only selected access to code, data, devices, or services.",
      "anchor": "glossary-term-compartment"
    },
    {
      "title": "Compartmentalisation",
      "link": "/build/technology/compartmentalisation/",
      "definition": "The division of software into isolated components so that a fault or compromise in one component has limited authority over the rest of the system.",
      "anchor": "glossary-term-compartmentalisation"
    },
    {
      "title": "Compressed capability",
      "link": null,
      "definition": "A capability representation that encodes bounds relative to the current address, allowing capability metadata and a conventional-sized address to fit within a practical in-memory format.",
      "anchor": "glossary-term-compressed-capability"
    },
    {
      "title": "Cursor",
      "link": null,
      "definition": "The current address within a capability. It can move within the authority described by the capability but does not itself define the capability's bounds.",
      "anchor": "glossary-term-cursor"
    },
    {
      "title": "Default Data Capability (DDC)",
      "link": null,
      "definition": "A capability used by some CHERI execution models as the default authority for data accesses that are not made through an explicit capability register.",
      "anchor": "glossary-term-default-data-capability-ddc"
    },
    {
      "title": "Dereference",
      "link": null,
      "definition": "Using a pointer or capability to read or write the memory it refers to. CHERI checks validity, bounds, permissions, and other relevant rules when a capability is dereferenced.",
      "anchor": "glossary-term-dereference"
    },
    {
      "title": "FPGA",
      "link": null,
      "definition": "A field-programmable gate array, or FPGA, is a programmable chip that can be configured to feature a processor and system design. This makes it a practical bridge between simulation and silicon.",
      "anchor": "glossary-term-fpga"
    },
    {
      "title": "Hybrid ABI",
      "link": "/build/technology/hybrid-systems/",
      "definition": "An application binary interface in which conventional pointers remain the default while software can explicitly use capabilities for selected data and interfaces.",
      "anchor": "glossary-term-hybrid-abi"
    },
    {
      "title": "Instruction-set architecture (ISA)",
      "link": null,
      "definition": "The programmer-visible contract between software and a processor, including instructions, registers, data types, exceptions, and memory behaviour.",
      "anchor": "glossary-term-instruction-set-architecture-isa"
    },
    {
      "title": "Least privilege",
      "link": null,
      "definition": "The principle that code should receive only the authority required for its function. Capability bounds and permissions provide mechanisms for expressing narrower authority.",
      "anchor": "glossary-term-least-privilege"
    },
    {
      "title": "Memory safety",
      "link": "/discover/why-cheri/approaches-to-memory-safety/",
      "definition": "Protection against invalid uses of memory, including accesses outside an object's bounds and, where temporal protection is present, accesses after an object's lifetime has ended.",
      "anchor": "glossary-term-memory-safety"
    },
    {
      "title": "Monotonicity",
      "link": null,
      "definition": "The rule that deriving a capability can preserve or reduce its authority but cannot increase it beyond the authority of the source capability.",
      "anchor": "glossary-term-monotonicity"
    },
    {
      "title": "Morello",
      "link": "/hardware/morello/",
      "definition": "Arm's experimental high-performance processor, SoC, and development board implementing an adaptation of CHERI for the Arm architecture.",
      "anchor": "glossary-term-morello"
    },
    {
      "title": "Non-forgeability",
      "link": null,
      "definition": "The property that software cannot create a valid capability with new authority merely by constructing or modifying its bit pattern.",
      "anchor": "glossary-term-non-forgeability"
    },
    {
      "title": "Object capability",
      "link": null,
      "definition": "An unforgeable reference that both identifies an object and authorises a defined set of operations on it.",
      "anchor": "glossary-term-object-capability"
    },
    {
      "title": "Permission",
      "link": null,
      "definition": "A right recorded in a capability, such as permission to load data, store data, or execute code. An operation is rejected when the relevant permission is absent.",
      "anchor": "glossary-term-permission"
    },
    {
      "title": "Pointer",
      "link": null,
      "definition": "A pointer is a value that contains the address of a location in memory. In conventional systems, this is just an integer.",
      "anchor": "glossary-term-pointer"
    },
    {
      "title": "Pointer provenance",
      "link": "/build/technology/cheri-capabilities/provenance/",
      "definition": "Information about where a pointer came from and which storage or object it is authorised to reference. CHERI makes valid provenance a hardware-enforced part of pointer use.",
      "anchor": "glossary-term-pointer-provenance"
    },
    {
      "title": "Program Counter Capability (PCC)",
      "link": null,
      "definition": "The capability that authorises instruction fetch and constrains the region of code that can execute in the current context.",
      "anchor": "glossary-term-program-counter-capability-pcc"
    },
    {
      "title": "Pure-capability ABI",
      "link": "/build/technology/pure-capability-systems/",
      "definition": "An application binary interface in which language-level pointers, code pointers, return addresses, and related runtime structures are represented with capabilities.",
      "anchor": "glossary-term-pure-capability-abi"
    },
    {
      "title": "RISC-V",
      "link": "/discover/history/risc-v-and-embedded-development/",
      "definition": "An open instruction-set architecture. CHERI extensions for RISC-V have been used in research processors, embedded systems, and ongoing standardisation work.",
      "anchor": "glossary-term-risc-v"
    },
    {
      "title": "Revocation",
      "link": null,
      "definition": "The process of making previously issued capabilities unusable when their authority should no longer apply, such as after memory has been freed or a compartment has been torn down.",
      "anchor": "glossary-term-revocation"
    },
    {
      "title": "Sail",
      "link": null,
      "definition": "A language for describing instruction-set architectures formally. CHERI uses Sail models as executable specifications and as inputs to testing and proof tools.",
      "anchor": "glossary-term-sail"
    },
    {
      "title": "Sealed capability",
      "link": "/build/technology/cheri-capabilities/sealing/",
      "definition": "A capability placed in a protected sealed state. It cannot be used for ordinary memory access until an authorised mechanism unseals or invokes it.",
      "anchor": "glossary-term-sealed-capability"
    },
    {
      "title": "Sentry capability",
      "link": null,
      "definition": "A sealed executable capability used to provide a controlled entry point into code without exposing unrestricted access to the target code capability.",
      "anchor": "glossary-term-sentry-capability"
    },
    {
      "title": "Spatial memory safety",
      "link": "/build/technology/spatial-memory-safety/",
      "definition": "Protection against accessing memory outside the intended bounds of an object, allocation, stack frame, or other region.",
      "anchor": "glossary-term-spatial-memory-safety"
    },
    {
      "title": "Tag",
      "link": "/build/technology/cheri-capabilities/tags-and-validity/",
      "definition": "A protected validity bit associated with a capability. Ordinary data operations cannot manufacture a set tag, and operations that corrupt a capability representation clear it.",
      "anchor": "glossary-term-tag"
    },
    {
      "title": "Tagged memory",
      "link": null,
      "definition": "Memory that stores capability validity tags separately from ordinary software-visible data so that the integrity of in-memory capabilities can be enforced.",
      "anchor": "glossary-term-tagged-memory"
    },
    {
      "title": "Temporal memory safety",
      "link": "/build/technology/temporal-memory-safety/",
      "definition": "Protection against using memory outside its valid lifetime, including use-after-free and use-after-reallocation errors.",
      "anchor": "glossary-term-temporal-memory-safety"
    },
    {
      "title": "Trusted computing base (TCB)",
      "link": null,
      "definition": "The hardware and software that must behave correctly for a system's security properties to hold. Compartmentalisation can reduce the amount of code trusted by any one component.",
      "anchor": "glossary-term-trusted-computing-base-tcb"
    },
    {
      "title": "Use-after-free",
      "link": "/build/technology/temporal-memory-safety/",
      "definition": "A temporal memory-safety error in which software accesses an allocation after it has been released and may have been reused for another purpose.",
      "anchor": "glossary-term-use-after-free"
    }
  ],
