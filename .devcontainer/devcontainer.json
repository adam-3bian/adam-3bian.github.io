{
  "name": "CHERI Alliance — Jekyll on Alpine",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/cheri-alliance,type=bind",
  "workspaceFolder": "/workspaces/cheri-alliance",
  "remoteUser": "vscode",
  "forwardPorts": [4000],
  "portsAttributes": {
    "4000": {
      "label": "Jekyll preview",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "bundle check || bundle install"
}
