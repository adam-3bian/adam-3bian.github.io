---
layout: null
permalink: /assets/search-index.json
---
{%- assign public_records = '' | split: '' -%}{%- assign public_urls = '' | split: '' -%}
{%- assign public_candidates = site.pages | concat: site.documents | sort: 'url' -%}
{%- for candidate in public_candidates -%}
  {%- assign public_entry = site.data.page-map | where: 'url', candidate.url | first -%}
  {%- if public_entry -%}{%- unless candidate.alternate or candidate.layout == 'redirect' or candidate.published == false or site.data.viewer.aliases[candidate.url] or candidate.url == '/checks/' or site.data.viewer.discovery_exclusions contains candidate.url -%}
    {%- unless public_urls contains candidate.url -%}{%- assign public_records = public_records | push: candidate -%}{%- assign public_urls = public_urls | push: candidate.url -%}{%- endunless -%}
  {%- endunless -%}{%- endif -%}
{%- endfor -%}
{"version":1,"records":[{% assign search_separator = '' %}{% for record in public_records %}{% unless record.url == '/search/' %}
{% assign search_title = record.title %}{% if record.url == '/' %}{% assign search_title = site.data.landing.home.title %}{% endif %}
{% assign search_type = record.collection | default: 'pages' %}
{% assign search_text = record.content | markdownify | strip_html | normalize_whitespace | replace: '&amp;', '&' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&lt;', '<' | replace: '&gt;', '>' | truncate: 1200 %}
{% assign search_summary = record.summary | default: search_text | truncate: 240 %}
{% if search_type == 'academic-papers' and record.summary == nil %}{% assign search_paragraphs = record.content | markdownify | split: '<p>' %}{% if search_paragraphs.size > 2 %}{% assign search_summary = search_paragraphs[2] | split: '</p>' | first | strip_html | normalize_whitespace | replace: '&amp;', '&' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&lt;', '<' | replace: '&gt;', '>' | truncate: 240 %}{% endif %}{% endif %}
{% assign search_date = record.published_date | default: record.published_year | default: record.start_datetime | default: record.start_date | default: record.document_date | default: record.updated_date | default: '' | append: '' %}
{% capture search_keywords %}{{ record.type }} {{ record.architecture }} {{ record.status }} {{ record.publisher }} {{ record.publication_type }}{% for slug in record.related.hardware %} {{ slug }}{% endfor %}{% for slug in record.related.software %} {{ slug }}{% endfor %}{% for slug in record.authors %}{% assign search_author = site.people | where: 'slug', slug | first %} {{ search_author.title }}{% endfor %}{% endcapture %}{% assign search_keywords = search_keywords | normalize_whitespace %}
{{ search_separator }}{"title":{{ search_title | jsonify | replace: '<', '\u003c' | replace: '>', '\u003e' | replace: '&', '\u0026' }},"url":{% assign search_url = record.url | relative_url %}{{ search_url | jsonify | replace: '<', '\u003c' | replace: '>', '\u003e' | replace: '&', '\u0026' }},"type":{{ search_type | jsonify | replace: '<', '\u003c' | replace: '>', '\u003e' | replace: '&', '\u0026' }},"summary":{{ search_summary | jsonify | replace: '<', '\u003c' | replace: '>', '\u003e' | replace: '&', '\u0026' }},"text":{{ search_text | jsonify | replace: '<', '\u003c' | replace: '>', '\u003e' | replace: '&', '\u0026' }},"keywords":{{ search_keywords | jsonify | replace: '<', '\u003c' | replace: '>', '\u003e' | replace: '&', '\u0026' }},"date":{{ search_date | jsonify | replace: '<', '\u003c' | replace: '>', '\u003e' | replace: '&', '\u0026' }}}{% assign search_separator = ',' %}
{% endunless %}{% endfor %}]}
