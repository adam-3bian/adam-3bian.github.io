  "/": {
    "title": "Software runs our world. It deserves stronger security foundations.",
    "summary": "CHERI is an open security technology that enhances processors with hardware-enforced mechanisms to help software manage memory more safely, contain vulnerabilities, and reduce the impact of attacks.",
    "columns": 1,
    "groups": [

    ],
    "links": [
      {
        "title": "Discover CHERI",
        "url": "/discover/"
      },
